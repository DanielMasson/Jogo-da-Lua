# Copie este arquivo para ".env" e preencha com as credenciais do SEU
# projeto Firebase (console.firebase.google.com > Configurações do
# projeto > Geral > Seus apps > Web).
#
# O prefixo VITE_ é obrigatório: o Vite só expõe ao código do navegador
# variáveis de ambiente que começam com esse prefixo.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
